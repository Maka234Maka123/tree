  abort                 中止当前合并，回滚冲突状态

  jobs-clean            清理所有并行任务和 worktree

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
紧急修复命令 (Hotfix)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  hotfix <name> [base]  创建紧急修复分支 (基于 main/master)

  hotfix-done [-p]      完成 hotfix 并合并回主分支
                        -p: 自动推送到远程

  hotfix-status         查看当前 hotfix 状态

  hotfix-clean          清理 hotfix (不合并)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
同步命令
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  sync                  同步主分支更新到当前分支
  sync all              同步主分支更新到所有工作分支

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
示例
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

单人工作流:
  wt new feature-login          # 创建并进入 feature-login 分支
  wt new hotfix-bug main        # 基于 main 创建 hotfix-bug
  wt back -m                    # 返回上一个工作空间并合并

并行工作流 (多个 Claude Code):
  # 1. 创建三个并行工作空间
  wt spawn main task-1 task-2 task-3

  # 2. 在三个终端中分别进入各个工作空间
  #    终端1: cd .worktrees/myrepo/task-1 && claude
  #    终端2: cd .worktrees/myrepo/task-2 && claude
  #    终端3: cd .worktrees/myrepo/task-3 && claude

  # 3. 各个 Claude Code 完成后，在对应目录执行
  wt done                       # 标记当前分支完成

  # 4. 查看任务状态
  wt jobs

  # 5. 预检查冲突
  wt check

  # 6. 全部完成后合并
  wt merge-all

  # 7. 如果有冲突
  #    - 手动解决冲突
  #    - git add <冲突文件>
  #    - git commit
  #    - wt merge-all (继续合并剩余分支)
  #    或者: wt abort (放弃合并)

紧急修复 (正在开发时处理 bug):
  # 1. 正在用 Claude Code 开发 feature...
  #    突然收到紧急 bug 报告

  # 2. 在当前终端创建 hotfix (不影响正在开发的 feature)
  wt hotfix bug-123

  # 3. 打开新终端，进入 hotfix 目录，启动另一个 Claude Code
  cd <输出的路径> && claude

  # 4. 修复完成后
  wt hotfix-done -p             # 合并并推送

  # 5. 继续原来的 feature 开发 (不受影响)
EOF
}

# 主函数
main() {
    # 检查是否在 git 仓库中
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo -e "${RED}错误: 当前目录不是 git 仓库${NC}"
        exit 1
    fi

    local command="${1:-help}"
    shift 2>/dev/null || true

    case "$command" in
        # 基础命令
        new|n)
            cmd_new "$@"
            ;;
        back|b)
            cmd_back "$@"
            ;;
        go|g)
            cmd_go "$@"
            ;;
        list|ls|l)
            cmd_list "$@"
            ;;
        status|st|s)
            cmd_status "$@"
            ;;
        remove|rm|r)
            cmd_remove "$@"
            ;;
        clean|c)
            cmd_clean "$@"
            ;;
        # 并行工作流命令
        spawn|sp)
            cmd_spawn "$@"
            ;;
        jobs|j)
            cmd_jobs "$@"
            ;;
        done|d)
            cmd_done "$@"
            ;;
        check|ck)
            cmd_check "$@"
            ;;
        merge-all|ma)
            cmd_merge_all "$@"
            ;;
        abort)
            cmd_abort "$@"
            ;;
        jobs-clean|jc)
            cmd_jobs_clean "$@"
            ;;
        # 紧急修复命令
        hotfix|hf)
            cmd_hotfix "$@"
            ;;
        hotfix-done|hfd)
            cmd_hotfix_done "$@"
            ;;
        hotfix-status|hfs)
            cmd_hotfix_status "$@"
            ;;
        hotfix-clean|hfc)
            cmd_hotfix_clean "$@"
            ;;
        # 同步命令
        sync)
            cmd_sync "$@"
            ;;
        # 帮助
        help|h|--help|-h)
            cmd_help
            ;;
        *)
            echo -e "${RED}未知命令: $command${NC}"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
