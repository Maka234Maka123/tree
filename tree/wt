#!/bin/bash

# Git Worktree 工作流管理工具
# 用法: wt <command> [options]

set -e

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 加载库文件
source "$SCRIPT_DIR/lib/colors.sh"
source "$SCRIPT_DIR/lib/helpers.sh"
source "$SCRIPT_DIR/lib/cmd_basic.sh"
source "$SCRIPT_DIR/lib/cmd_parallel.sh"
source "$SCRIPT_DIR/lib/cmd_sync.sh"
source "$SCRIPT_DIR/lib/help.sh"

# 主函数
main() {
    # 检查是否在 git 仓库中
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo -e "${RED}错误: 当前目录不是 git 仓库${NC}"
        exit 1
    fi

    local command="${1:-help}"
    shift 2>/dev/null || true

    case "$command" in
        # 基础命令
        new|n)
            cmd_new "$@"
            ;;
        back|b)
            cmd_back "$@"
            ;;
        go|g)
            cmd_go "$@"
            ;;
        list|ls|l)
            cmd_list "$@"
            ;;
        status|st|s)
            cmd_status "$@"
            ;;
        remove|rm|r)
            cmd_remove "$@"
            ;;
        clean|c)
            cmd_clean "$@"
            ;;
        # 并行工作流命令
        spawn|sp)
            cmd_spawn "$@"
            ;;
        jobs|j)
            cmd_jobs "$@"
            ;;
        done|d)
            cmd_done "$@"
            ;;
        check|ck)
            cmd_check "$@"
            ;;
        merge-all|ma)
            cmd_merge_all "$@"
            ;;
        abort)
            cmd_abort "$@"
            ;;
        jobs-clean|jc)
            cmd_jobs_clean "$@"
            ;;
        # 同步命令
        sync)
            cmd_sync "$@"
            ;;
        # 帮助
        help|h|--help|-h)
            cmd_help
            ;;
        *)
            echo -e "${RED}未知命令: $command${NC}"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
